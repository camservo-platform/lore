# Copy to secrets.env (gitignored) and fill in. deploy.sh reads it and stores the
# keys in the cluster's lore-credentials secret; they never go into git or Helm values.
DEEPGRAM_API_KEY=
LLM_API_KEY=
# Optional: GitHub sign-in on stable (an OAuth App with callback https://<host>/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: GitHub sign-in on dev. An OAuth App has one callback URL, so dev needs its
# own app (callback https://<dev host>/auth/github/callback).
DEV_GITHUB_CLIENT_ID=
DEV_GITHUB_CLIENT_SECRET=
