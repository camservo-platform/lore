     "legendFormat": "{{mode}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "pointSize": 8,
      "showPoints": "never",
      "axisSoftMin": 0,
      "stacking": {
       "mode": "none"
