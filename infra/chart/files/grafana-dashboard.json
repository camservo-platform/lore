    }
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Tool calls per minute",
   "description": "ok: worked. refused: the game said no, which is normal play. failed: a game server couldn't be reached.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (outcome) (rate(lore_tool_calls_total[$__rate_interval])) * 60",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "custom": {
      "lineWidth": 2,
